# =============================================================================
# ConnectSphere - Environment Variables (TEMPLATE)
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must NEVER be committed. This file (.env.example) IS committed
# so that teammates and the instructors know which variables are required.
# =============================================================================

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ConnectSphere Event Services"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Supabase --------------------------------------------------------------
# LOCAL DEV: run `npm run db:start` (Supabase CLI) and copy the printed values.
# The local anon/service keys below are the Supabase CLI's well-known demo keys
# - they are identical on every machine and are NOT secrets.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# SERVER-ONLY. Bypasses Row Level Security. Never expose to the browser and
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

