# =============================================================================
# ConnectSphere - Environment Variables (TEMPLATE)
# -----------------------------------------------------------------------------
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must NEVER be committed. This file IS committed so teammates and instructors
# know which variables are required.
#
#   cp .env.example .env.local
#
# Values come from your Supabase dashboard - see docs/SUPABASE_SETUP.md.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ConnectSphere Event Services"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase (required) -----------------------------------------------------
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Project Settings -> API -> anon public. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Project Settings -> API -> service_role.
# SERVER-ONLY AND SECRET. Bypasses row-level security. Never expose it to the
# browser and NEVER prefix it with NEXT_PUBLIC_ - anything so prefixed is
# inlined into the client bundle.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase (optional) -----------------------------------------------------
# Project Settings -> Database -> Connection string.
# Only needed for direct SQL access or integration tests against Postgres.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Local development stack -------------------------------------------------
# If you run `npm run db:start` instead of using the cloud project, swap the
# Supabase values above for these. They are the Supabase CLI's well-known demo
# keys: identical on every machine, and not secrets.
#
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"

# --- Add as features land ----------------------------------------------------
# Not read by src/lib/env.ts yet. Add the variable here AND to the schema in
# src/lib/env.ts at the same time, so a missing value fails at boot rather than
# silently at runtime.
#
# SENDGRID_API_KEY=""          # email notifications
# SENDGRID_FROM_EMAIL=""
# CRON_SECRET=""               # shared secret for scheduled /api/jobs/* routes
